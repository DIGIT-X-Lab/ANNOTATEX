# AnnotateX Environment Configuration Example
# Copy this file to .env and update with your values

# Application
NODE_ENV=production
PORT=8080

# Domain (for production)
DOMAIN=annotatex.yourdomain.com

# Security (generate secure values for production)
# SESSION_SECRET=your-session-secret-here

# Database (if you add backend features later)
# DATABASE_URL=postgresql://user:password@localhost:5432/annotatex

# API Keys (if you integrate external services)
# AI_API_KEY=your-api-key-here

# Logging
LOG_LEVEL=info

# Feature Flags
# ENABLE_AI_ASSIST=false
# ENABLE_COLLABORATION=false
